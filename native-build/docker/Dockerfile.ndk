FROM debian:bookworm-slim

ARG NDK_VERSION
ARG NDK_SHA256

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config patch python3 \
        git curl ca-certificates unzip xz-utils bison \
        libboost-dev libevent-dev libsqlite3-dev \
        perl autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*

RUN test -n "$NDK_SHA256" || { echo "NDK_SHA256 is empty, run native-build/pin-ndk.sh and set it in core-source.env" >&2; exit 1; } \
    && curl -fsSL -o /tmp/ndk.zip "https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip" \
    && echo "${NDK_SHA256}  /tmp/ndk.zip" | sha256sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && mv "/opt/android-ndk-${NDK_VERSION}" /opt/android-ndk \
    && rm /tmp/ndk.zip

ENV ANDROID_NDK_HOME=/opt/android-ndk

COPY build-in-container.sh /usr/local/bin/build-in-container.sh
RUN chmod 0755 /usr/local/bin/build-in-container.sh
