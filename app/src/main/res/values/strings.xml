    <string name="fr_how_link">How does this work?</string>
    <string name="fr_how_title">How it works</string>
    <string name="fr_how_body">This app runs a full copy of the Elektron network on your phone. It checks every payment itself instead of trusting a server. It syncs in the background and uses some data and battery. You decide when it runs and you can pause or stop it at any time.</string>
    <string name="fr_network_title">Sync only on Wi-Fi?</string>
    <string name="fr_network_body">The first sync downloads a lot of data. Wi-Fi only is recommended. You can change this later in Settings.</string>
    <string name="fr_network_wifi">Wi-Fi only (recommended)</string>
    <string name="fr_network_any">Wi-Fi and mobile data</string>
    <string name="fr_notify_title">Background notification</string>
    <string name="fr_notify_body">The node runs in the background and shows its status in a notification. You can pause or stop it there.</string>
    <string name="fr_continue">Continue</string>
