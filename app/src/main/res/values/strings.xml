    <string name="fr_phrase_warning">Write these words down on paper. Anyone with them can take your coins. We cannot recover them for you.</string>
    <string name="fr_strength_label">Length of the recovery phrase</string>
    <string name="fr_strength_12">12 words (128 bit)</string>
    <string name="fr_strength_24">24 words (256 bit)</string>
